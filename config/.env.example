# Copy this file to config/.env and fill in every value.
# config/.env is gitignored and must never be committed.
# Reference: docs/Environment_Config_Reference.docx section 3.
#
# Leaving a variable blank is the same as omitting it: the documented default
# applies, and optional credentials stay unset rather than becoming "".
# Relative paths are resolved against the repository root, not the working
# directory, so scheduled runs resolve them the same way manual runs do.

# --- Source API credentials ----------------------------------------------
# Integration token for the Notion API.
NOTION_API_KEY=
# Path to the Gmail API OAuth credentials JSON file.
GMAIL_CREDENTIALS_PATH=
# Personal access token for the GitHub REST API.
GITHUB_TOKEN=
# Path to the Google Calendar API OAuth credentials JSON file.
GOOGLE_CALENDAR_CREDENTIALS_PATH=
# Absolute path to the browser's local History SQLite file.
# Windows (Chrome): C:\Users\<you>\AppData\Local\Google\Chrome\User Data\Default\History
BROWSER_HISTORY_PATH=
# Comma-separated list of folders the file watcher monitors.
LOCAL_FILES_WATCH_DIRS=

# --- LLM provider credentials --------------------------------------------
# Required only if provider_mode is fully_cloud or mixed.
OPENROUTER_API_KEY=
# Base URL for the local Ollama instance.
OLLAMA_HOST=http://localhost:11434

# --- Storage connection settings -----------------------------------------
# Filesystem path to the SQLite database file.
SQLITE_DB_PATH=./data/pkg_agent.db
# Local directory where Chroma persists its embedded collection.
CHROMA_PERSIST_DIR=./data/chroma
# Bolt connection URI for the local Neo4j Community Edition instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Application settings -------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Port the backend binds to.
FASTAPI_PORT=8080
# LangSmith tracing and evaluation.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-knowledge-graph-agent
# Leave this false/blank for a manual developer setup -- docker-compose.yml
# sets this to true itself, in its own environment block. Do not set this
# by hand.
RUNNING_IN_DOCKER=false
