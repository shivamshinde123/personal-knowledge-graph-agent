   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "60 is the value from the original RRF paper (Cormack, Clarke & B\u00fcttcher, 2009), not a tuned number.",
   "originalText": "60 is the value from the original RRF paper (Cormack, Clarke & B\u00fcttcher, 2009), not a tuned number.",
