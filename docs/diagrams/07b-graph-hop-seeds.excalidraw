   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it helps: capstone-app never says \u201cdemo\u201d or \u201cemail\u201d, so search alone misses it. Its link to the Capstone plan finds it.",
   "originalText": "Why it helps: capstone-app never says \u201cdemo\u201d or \u201cemail\u201d, so search alone misses it. Its link to the Capstone plan finds it.",
