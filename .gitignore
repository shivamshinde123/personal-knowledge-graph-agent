# --- Secrets -------------------------------------------------------------
# config/.env holds every API key and DB credential; never commit it.
config/.env
.env
*.pem
*credentials*.json
*token*.json
# Google Cloud Console's own default filename for a downloaded OAuth
# client (Gmail/Calendar setup) — doesn't match *credentials*.json above.
client_secret*.json

# --- Local data stores ---------------------------------------------------
# All three stores hold personal data and are rebuilt by the daily batch.
data/
*.db
*.sqlite
*.sqlite3
chroma/
.chroma/
# docker/storage/ (HOST_STORAGE_DIR's default -- see docker-compose.yml)
# holds the same real data plus whatever else the running container drops
# there (e.g. backend_port.txt) -- *.db/chroma/ above already cover the
# two data files specifically, but ignore everything in the directory
# generically too rather than relying on that staying an exhaustive list.
docker/storage/*
!docker/storage/.gitkeep

# --- Python --------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# --- Node / frontend -----------------------------------------------------
node_modules/
frontend/build/
frontend/dist/
npm-debug.log*

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Model caches --------------------------------------------------------
.cache/
models/
