# Copy this file to .env, at the repo root, next to docker-compose.yml --
# distinct from config/.env, which is the application's own configuration
# and is unaffected by this file. This one is read only by
# `docker compose` itself, to fill in the ${VARS} referenced in
# docker-compose.yml (volume paths, published ports, Neo4j's password).
#
# config/.env still needs to exist and be filled in the same way a manual
# developer setup requires (see config/.env.example) -- docker-compose.yml
# mounts it into the backend/scheduler containers read-only via `env_file`.
# A guided setup wizard that removes this manual step is tracked
# separately (issue #92); not built yet.

# --- Required ---------------------------------------------------------
# Neo4j's password for its built-in `neo4j` user. Anything non-empty.
NEO4J_PASSWORD=

# --- Local files / browser history -------------------------------------
# Host folder to make available for the "Local folders to watch" source.
# Once running, Settings shows this mounted path read-only (see
# DECISIONS.md, issue #52) -- to change it, edit this line and run
# `docker compose up -d` again.
# Windows example: HOST_WATCH_DIR=C:\Users\you\Documents\Notes
HOST_WATCH_DIR=
# A second, general-purpose host folder made available read-only at
# /host-data inside the backend/scheduler containers -- point
# config/.env's GMAIL_CREDENTIALS_PATH, GOOGLE_CALENDAR_CREDENTIALS_PATH,
# and/or BROWSER_HISTORY_PATH at a file under /host-data/... once you've
# copied it here (e.g. HOST_DATA_DIR=C:\Users\you\pkg-agent-secrets, then
# config/.env's GMAIL_CREDENTIALS_PATH=/host-data/gmail_credentials.json).
HOST_DATA_DIR=

# --- Ports (all optional -- defaults shown) ------------------------------
HOST_FRONTEND_PORT=3000
HOST_BACKEND_PORT=8080
HOST_NEO4J_HTTP_PORT=7474
HOST_NEO4J_BOLT_PORT=7687
HOST_OLLAMA_PORT=11434

# --- Local LLM (Ollama) ---------------------------------------------------
# Uncomment to also start the Ollama container -- only needed when
# config/.env's provider_mode is fully_local. Equivalent to running
# `docker compose --profile local-llm up -d` instead.
# COMPOSE_PROFILES=local-llm
