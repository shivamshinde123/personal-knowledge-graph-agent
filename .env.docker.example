# Copy this file to .env, at the repo root, next to docker-compose.yml --
# distinct from config/.env, which is the application's own configuration
# and is unaffected by this file. This one is read only by
# `docker compose` itself, to fill in the ${VARS} referenced in
# docker-compose.yml (volume paths, published ports, Neo4j's password).
#
# config/.env still needs to exist (copy config/.env.example to
# config/.env) -- docker-compose.yml bind-mounts the whole config/
# directory into the backend/scheduler containers read-write, so once the
# stack is up, the guided setup wizard (Settings -> "Guided setup") can
# fill config/.env in for you: credentials, Google OAuth, source scope,
# local files, browser history. Nothing below is required for that --
# only for the container stack to start at all.

# --- Optional (defaults shown) ------------------------------------------
# Neo4j's password for its built-in `neo4j` user. Defaults to a known
# value for a true one-command start -- change it (and re-run
# `docker compose up -d`) if this machine is ever reachable from a
# shared/untrusted network, since the Neo4j ports below publish to every
# host interface by default, not just 127.0.0.1. See DECISIONS.md.
NEO4J_PASSWORD=pkg-agent-local

# Host folder SQLite/Chroma's data lives under -- defaults to
# ./docker/storage (next to this file) so out-of-the-box behavior needs
# nothing set here. Point it elsewhere to keep your data on a different
# drive/folder; there's no in-app picker for this one (unlike the sources
# below) since it's a single, once-at-deploy decision, not something to
# narrow at runtime. Changing this later does NOT move existing data --
# move the files yourself first if you want to keep them.
HOST_STORAGE_DIR=./docker/storage

# --- Local files / browser history -------------------------------------
# Host folder to make available for the "Local folders to watch" source.
# Once running, Settings/the wizard let you pick which subfolders of this
# mount to actually watch -- to mount a *different* host folder entirely,
# edit this line and run `docker compose up -d` again. See DECISIONS.md,
# issue #92.
# Windows example: HOST_WATCH_DIR=C:\Users\you\Documents\Notes
HOST_WATCH_DIR=
# A second, general-purpose host folder made available read-only at
# /host-data inside the backend/scheduler containers -- point
# config/.env's GMAIL_CREDENTIALS_PATH, GOOGLE_CALENDAR_CREDENTIALS_PATH,
# and/or BROWSER_HISTORY_PATH at a file under /host-data/... once you've
# copied it here (e.g. HOST_DATA_DIR=C:\Users\you\pkg-agent-secrets, then
# config/.env's GMAIL_CREDENTIALS_PATH=/host-data/gmail_credentials.json).
HOST_DATA_DIR=

# --- Ports (all optional -- defaults shown) ------------------------------
HOST_FRONTEND_PORT=3000
HOST_BACKEND_PORT=8080
HOST_NEO4J_HTTP_PORT=7474
HOST_NEO4J_BOLT_PORT=7687
HOST_OLLAMA_PORT=11434

# --- Local LLM (Ollama) ---------------------------------------------------
# Uncomment to also start the Ollama container -- only needed when
# config/.env's provider_mode is fully_local. Equivalent to running
# `docker compose --profile local-llm up -d` instead.
# COMPOSE_PROFILES=local-llm
